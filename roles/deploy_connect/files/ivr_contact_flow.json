{
  "Version": "2019-10-30",
  "StartAction": "startMenu",
  "Actions": [
    {
      "Identifier": "startMenu",
      "Type": "GetUserInput",
      "Transitions": {
        "NextAction": "askUsername",
        "Errors": "hangup",
        "NoMatch": "startMenu"
      },
      "Parameters": {
        "Prompt": [
          {
            "Text": "Welcome. Press 9 to continue."
          }
        ],
        "InputType": "DTMF",
        "DTMFConfiguration": {
          "MinDigits": 1,
          "MaxDigits": 1,
          "Inclusion": "9"
        }
      }
    },
    {
      "Identifier": "askUsername",
      "Type": "GetUserInput",
      "Transitions": {
        "NextAction": "saveUsername",
        "Errors": "hangup",
        "NoMatch": "askUsername"
      },
      "Parameters": {
        "Prompt": [
          {
            "Text": "Please say your username after the beep."
          }
        ],
        "InputType": "Speech"
      }
    },
    {
      "Identifier": "saveUsername",
      "Type": "SetAttributes",
      "Parameters": {
        "Attributes": {
          "username": "$.CustomerInput"
        }
      },
      "Transitions": {
        "NextAction": "askEmpId"
      }
    },
    {
      "Identifier": "askEmpId",
      "Type": "GetUserInput",
      "Transitions": {
        "NextAction": "saveEmpId",
        "Errors": "hangup",
        "NoMatch": "askEmpId"
      },
      "Parameters": {
        "Prompt": [
          {
            "Text": "Say or enter your employee ID."
          }
        ],
        "InputType": "Speech"
      }
    },
    {
      "Identifier": "saveEmpId",
      "Type": "SetAttributes",
      "Parameters": {
        "Attributes": {
          "empid": "$.CustomerInput"
        }
      },
      "Transitions": {
        "NextAction": "confirmEmpId"
      }
    },
