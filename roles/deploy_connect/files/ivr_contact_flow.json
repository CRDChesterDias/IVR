{
  "Version": "1.0",
  "StartAction": "startMenu",
  "Metadata": {
    "Name": "Press-9-Username-EmpID-Flow",
    "Description": "IVR flow for username and employee ID capture",
    "ContactFlowType": "CONTACT_FLOW"
  },
  "Actions": [
    {
      "Identifier": "startMenu",
      "Type": "GetUserInput",
      "Transitions": {
        "NextAction": "askUsername",
        "Errors": "hangup",
        "NoMatch": "startMenu"
      },
      "Parameters": {
        "Prompt": [
          {
            "Text": "Welcome. Press 9 to continue."
          }
        ],
        "InputType": "DTMF",
        "DTMFConfiguration": {
          "MinDigits": 1,
          "MaxDigits": 1,
          "Inclusion": "9"
        }
      }
    },

    {
      "Identifier": "askUsername",
      "Type": "GetUserInput",
      "Transitions": {
        "NextAction": "saveUsername",
        "Errors": "hangup",
        "NoMatch": "askUsername"
      },
      "Parameters": {
        "Prompt": [
          {
            "Text": "Please enter your username followed by the pound key."
          }
        ],
        "InputType": "DTMF",
        "DTMFConfiguration": {
          "MinDigits": 1,
          "MaxDigits": 20,
          "TerminationDigit": "#"
        }
      }
    },

    {
      "Identifier": "saveUsername",
      "Type": "SetAttributes",
      "Parameters": {
        "Attributes": {
          "username": "$.CustomerInput"
        }
      },
      "Transitions": {
        "NextAction": "askEmpId"
      }
    },

    {
      "Identifier": "askEmpId",
      "Type": "GetUserInput",
      "Transitions": {
        "NextAction": "saveEmpId",
        "Errors": "hangup",
        "NoMatch": "askEmpId"
      },
      "Parameters": {
        "Prompt": [
          {
            "Text": "Please enter your employee ID followed by the pound key."
          }
        ],
        "InputType": "DTMF",
        "DTMFConfiguration": {
          "MinDigits": 1,
          "MaxDigits": 10,
          "TerminationDigit": "#"
        }
      }
    },

    {
      "Identifier": "saveEmpId",
      "Type": "SetAttributes",
      "Parameters": {
        "Attributes": {
          "empid": "$.CustomerInput"
        }
      },
      "Transitions": {
        "NextAction": "confirmEmpId"
      }
    },

    {
      "Identifier": "confirmEmpId",
      "Type": "GetUserInput",
      "Transitions": {
        "NextAction": "confirmed",
        "Errors": "hangup",
        "NoMatch": "confirmEmpId"
      },
      "Parameters": {
        "Prompt": [
          {
            "Text": "Press 1 to confirm your employee ID."
          }
        ],
        "InputType": "DTMF",
        "DTMFConfiguration": {
          "MinDigits": 1,
          "MaxDigits": 1,
          "Inclusion": "1"
        }
      }
    },

    {
      "Identifier": "confirmed",
      "Type": "PlayPrompt",
      "Parameters": {
        "Prompt": [
          {
            "Text": "Thank you. Your identity is confirmed."
          }
        ]
      },
      "Transitions": {
        "NextAction": "hangup"
      }
    },

    {
      "Identifier": "hangup",
      "Type": "Disconnect",
      "Transitions": {}
    }
  ]
}
